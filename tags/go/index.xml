				<description>&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;package main&#xA;&#xA;import (&#xA;    &amp;#34;fmt&amp;#34;&#xA;    &amp;#34;math/rand&amp;#34;&#xA;    &amp;#34;time&amp;#34;&#xA;)&#xA;&#xA;func main() {&#xA;    rand.Seed(time.Now().UnixNano())&#xA;    p := rand.Perm(100)&#xA;    for _, r := range p[:10] {&#xA;        fmt.Println(r)&#xA;    }&#xA;}&#xA;&lt;/code&gt;&lt;/pre&gt;</description>
